# Copia este archivo a .env y completa los valores.
# .env está en .gitignore: nunca se sube al repositorio.

# Token que te da @BotFather al crear el bot.
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs de Telegram autorizados, separados por coma. Sin esto, cualquiera
# que encuentre el bot podría escribir en tu diccionario.
# Para saber tu ID escríbele a @userinfobot.
ALLOWED_USER_IDS=123456789

# Opcional: ruta al ejecutable de Claude Code si no está en el PATH.
# Windows:  CLAUDE_BIN=C:\Users\TuUsuario\.local\bin\claude.cmd
# Linux:    CLAUDE_BIN=/home/tuusuario/.local/bin/claude
CLAUDE_BIN=

# Opcional: modelo a usar en el procesamiento automático.
CLAUDE_MODEL=

# Pon 0 si no quieres que el bot haga push automático (solo commit local).
GIT_PUSH=1

# Capturas del ALCPT: se leen con OCR local (sin Claude Code). Si el parser no
# logra estructurar una, por defecto avisa y no gasta tokens ("off").
# Pon "claude" para que en ese caso le pase la imagen a Claude Code.
CAPTURE_FALLBACK=off

# Segundos de calma tras el último cambio antes de regenerar documentos y hacer
# commit + push. Las capturas suelen llegar en ráfaga; así va un solo lote.
FLUSH_DELAY=30

# Listas de vocabulario en captura (TikTok, apuntes): tras extraerlas en local,
# Claude repone tildes y matices con solo texto (pocos tokens). 0 para dejarlas
# tal como las leyó el OCR.
VOCAB_POLISH=1
