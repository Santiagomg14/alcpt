# Capturas de los exámenes: material de origen, pesado y ya procesado en data/*.json
inbox/*
!inbox/.gitkeep

# Respaldos locales (el historial de git los reemplaza)
*.bak

# Secretos: tokens del bot, claves de API
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Estado local del bot (desplazamiento de mensajes de Telegram)
bot/state.json

# Registro del bot
bot/bot.log

# Registro de capturas ya procesadas (caché local: sha256 -> resultado)
bot/processed.json

# Capturas de origen: las imágenes SÍ se versionan (respaldo), el texto OCR no
capturas/**/*.txt
